---
import LeadForm from './LeadForm.astro';
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// The dealership lot at dusk, supplied by the client. Sits behind the hero at
// low opacity under the scrim below, so the headline keeps its contrast.
const heroImage: string | null = '/images/hero.webp';
---

<section class="hero" data-has-image={heroImage ? 'true' : 'false'} style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <h1>{t.hero.headline}</h1>
      <p class="hero__sub">{t.hero.sub}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#featured-vehicles">{t.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href={site.phoneHref}>{t.hero.ctaSecondary}</a>
      </div>
    </div>

    {site.heroForm && (
      <div class="hero__form" id="hero-form">
        <LeadForm
          formId="form_1_hero"
          lang={lang}
          heading={t.hero.formHeading}
          sub={t.hero.formSub}
          successBody={t.confirm.hero}
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background: var(--black);
    color: #c4c4c4;
    position: relative;
    padding-block: clamp(44px, 6vw, 80px);
  }
  .hero[data-has-image='true']::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
    opacity: 0.55;
  }

  /* Scrim so the headline and sub-copy keep their contrast wherever the photo
     happens to be light. Without it the sub-copy sits on whatever the image
     gives it, which changes the moment the photo is swapped. */
  .hero[data-has-image='true']::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(18, 18, 18, 0.88) 0%,
      rgba(18, 18, 18, 0.7) 34%,
      rgba(18, 18, 18, 0.28) 68%,
      rgba(18, 18, 18, 0.1) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(30px, 5vw, 60px);
    align-items: center;
  }
  .hero h1 {
    color: #fff;
    margin-bottom: 18px;
    max-width: 16ch;
  }
  .hero__sub {
    /* Slightly lighter than the no-photo default: this text sits over the
       lot photo, not over flat colour. */
    font-size: 17.5px;
    color: #d0d0d0;
    margin-bottom: 30px;
    max-width: 46ch;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero h1 { max-width: none; }
  }
</style>
